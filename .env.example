# Backend
SESSION_SECRET=
ADMIN_PASSWORD=
# Set to false for local http development so the session cookie round-trips.
COOKIE_SECURE=
# Salt for the coarse, non-reversible origin hash in the view tracking. Set a
# random value in production; unset falls back to a per-process default.
TRACKING_SALT=
# Fernet key encrypting the admin TOTP secret at rest. Generate one with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave unset to keep the second factor unavailable; never commit a real key.
TOTP_ENC_KEY=
# Set to true to expose the interactive API docs at /docs and /redoc for local
# development. Off everywhere else so the schema stays unexposed.
ENABLE_DOCS=

# Login through authentik
# Set to true to switch the login on. Off unless set, and then every variable
# below except OIDC_INTERNAL_URL must be set, or the backend refuses to start.
OIDC_ENABLED=
# Public issuer URL with the trailing slash, e.g.
# https://auth.wediga.dev/application/o/wediga-dev/
OIDC_ISSUER=
# The client ID of wediga.dev in the blueprint, wediga-dev.
OIDC_CLIENT_ID=
# Same value as WEDIGA_OIDC_CLIENT_SECRET in authentik.env.
OIDC_CLIENT_SECRET=
# Public URL of the callback route, e.g. https://www.wediga.dev/auth/callback
OIDC_REDIRECT_URI=
# Optional. Where the backend itself reaches authentik, e.g.
# http://authentik-server:9000 on the server. Unset means the issuer's origin.
OIDC_INTERNAL_URL=

# GitHub sync
# Account whose public repos are mirrored. Defaults to wediga when unset.
GITHUB_USERNAME=
# Optional read-only token. It only raises the hourly rate limit and is never
# logged or stored. The sync works without it.
GITHUB_TOKEN=
# Seconds between scheduled syncs (default six hours). Zero or less disables
# the scheduled refresh; the admin button still works.
GITHUB_SYNC_INTERVAL_SECONDS=

# Frontend
# Server-side URL of the backend. In compose this is http://backend:8000,
# for local development it defaults to http://localhost:8000.
BACKEND_URL=
