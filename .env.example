# Backend
SESSION_SECRET=
ADMIN_PASSWORD=
# Set to false for local http development so the session cookie round-trips.
COOKIE_SECURE=
# Salt for the coarse, non-reversible origin hash in the view tracking. Set a
# random value in production; unset falls back to a per-process default.
TRACKING_SALT=

# GitHub sync
# Account whose public repos are mirrored. Defaults to wediga when unset.
GITHUB_USERNAME=
# Optional read-only token. It only raises the hourly rate limit and is never
# logged or stored. The sync works without it.
GITHUB_TOKEN=
# Seconds between scheduled syncs (default six hours). Zero or less disables
# the scheduled refresh; the admin button still works.
GITHUB_SYNC_INTERVAL_SECONDS=

# Frontend
# Server-side URL of the backend. In compose this is http://backend:8000,
# for local development it defaults to http://localhost:8000.
BACKEND_URL=
