# Frontend image for the Next.js service.
# Three-stage build (deps -> builder -> runner) based on the official
# vercel/next.js examples/with-docker Dockerfile, using npm and the
# standalone output. Build context is the sibling ../frontend directory.

ARG NODE_VERSION=24.18.0

FROM node:${NODE_VERSION}-slim@sha256:b31e7a42fdf8b8aa5f5ed477c72d694301273f1069c5a2f71d53c6482e99a2fc AS deps
WORKDIR /app

# Install dependencies based on the lockfile only, for a cached layer.
COPY package.json package-lock.json ./
RUN npm ci

FROM node:${NODE_VERSION}-slim@sha256:b31e7a42fdf8b8aa5f5ed477c72d694301273f1069c5a2f71d53c6482e99a2fc AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

RUN npm run build

FROM node:${NODE_VERSION}-slim@sha256:b31e7a42fdf8b8aa5f5ed477c72d694301273f1069c5a2f71d53c6482e99a2fc AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# The runtime only runs the standalone server, so npm is not needed. Dropping
# the npm that ships in the base image removes a large set of npm-only CVEs and
# shrinks the attack surface.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

# Copy the standalone server, static assets and public files.
COPY --from=builder /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static

USER node

EXPOSE 3000

CMD ["node", "server.js"]
