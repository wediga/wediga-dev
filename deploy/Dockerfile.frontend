# Frontend image for the Next.js service.
# Three-stage build (deps -> builder -> runner) based on the official
# vercel/next.js examples/with-docker Dockerfile, using npm and the
# standalone output. Build context is the sibling ../frontend directory.

ARG NODE_VERSION=24.13.0

FROM node:${NODE_VERSION}-slim@sha256:4660b1ca8b28d6d1906fd644abe34b2ed81d15434d26d845ef0aced307cf4b6f AS deps
WORKDIR /app

# Install dependencies based on the lockfile only, for a cached layer.
COPY package.json package-lock.json ./
RUN npm ci

FROM node:${NODE_VERSION}-slim@sha256:4660b1ca8b28d6d1906fd644abe34b2ed81d15434d26d845ef0aced307cf4b6f AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production

RUN npm run build

FROM node:${NODE_VERSION}-slim@sha256:4660b1ca8b28d6d1906fd644abe34b2ed81d15434d26d845ef0aced307cf4b6f AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Copy the standalone server, static assets and public files.
COPY --from=builder /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static

USER node

EXPOSE 3000

CMD ["node", "server.js"]
