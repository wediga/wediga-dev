# Copy to /home/web/wediga-dev/wediga-db.env on the server and fill in the
# values. The real file never goes into the repository. The database
# container, the backend and backend-migrate all read it.

# PostgreSQL creates this user and database on its first start, so changing
# them later needs the data volume emptied.
POSTGRES_USER=
POSTGRES_DB=

# Hex only, so the value never needs quoting.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Where the backend reaches the database. The database container ignores
# these two. The host is the container name on the internal network.
POSTGRES_HOST=wediga-db
POSTGRES_PORT=5432
