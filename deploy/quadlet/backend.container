[Unit]
Description=wediga.dev backend (FastAPI)
# The schema must exist before the backend serves. Migrations run as a separate
# one-shot unit that this one requires and starts after.
Requires=backend-migrate.service
After=backend-migrate.service

[Container]
# Default tag for manual setup. The deploy rewrites this to the exact commit it
# builds, so a restart is reproducible and never a surprise upgrade.
Image=ghcr.io/wediga/wediga-dev-backend:main
ContainerName=backend
Network=wediga.network
EnvironmentFile=/home/web/wediga-dev/.env
# The database connection lives in its own file, shared with wediga-db.
EnvironmentFile=/home/web/wediga-dev/wediga-db.env
# Hardening: non-root image user, no new privileges, all capabilities dropped,
# read-only root filesystem, only /tmp is writable.
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp

[Service]
Restart=always

[Install]
WantedBy=default.target
