# Copy to /home/web/authentik/authentik.env on the server and fill in the
# values. The real file never goes into the repository.

# Signs sessions and tokens. Generate with: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=

# Must be the same value as POSTGRES_PASSWORD in authentik-db.env.
AUTHENTIK_POSTGRESQL__PASSWORD=

# Only read on the very first start. They give the built-in admin account
# "akadmin" a password right away, so the public setup page is never open to
# whoever finds it first. Remove both lines from the file after the first start.
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_EMAIL=
