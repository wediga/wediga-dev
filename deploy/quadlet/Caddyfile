{
	email wedig.alexander@gmail.com

	# Caddy does not open the public ports itself. systemd opens them through
	# caddy.socket and hands them over in the order they are listed there.
	default_bind fd/4 {
		protocols h1 h2
	}
	default_bind fdgram/5 {
		protocols h3
	}

	# The automatic redirect would need port 80 of its own, so the http://
	# site below takes it over.
	auto_https disable_redirects
}

http:// {
	bind fd/3 {
		protocols h1
	}
	redir https://{host}{uri} 308
}

wediga.dev {
	redir https://www.wediga.dev{uri} permanent
}

www.wediga.dev {
	reverse_proxy frontend:3000
}

# The CR Predictor lives in its own repository. Its container joins the same
# internal network, so its route is kept here next to the others.
cr-prediction.wediga.dev {
	reverse_proxy cr-predictor:8000
}

# The identity provider. Login pages, admin interface and API are all served
# by the authentik server container.
auth.wediga.dev {
	reverse_proxy authentik-server:9000
}

# The company site of NuviraLabs lives in its own repository. Its frontend
# joins the network nuviralabs, which Caddy shares, and the site uses the
# domain without www as its address.
nuviralabs.de {
	reverse_proxy nuviralabs-frontend:3000
}

www.nuviralabs.de {
	redir https://nuviralabs.de{uri} permanent
}
