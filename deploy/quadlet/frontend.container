[Unit]
Description=wediga.dev frontend (Next.js)
# Start order only, not a hard requirement, so a slow backend never blocks the
# frontend. The frontend reaches the backend at request time.
After=backend.service

[Container]
# Default tag for manual setup. The deploy rewrites this to the exact commit it
# builds, so a restart is reproducible and never a surprise upgrade.
Image=ghcr.io/wediga/wediga-dev-frontend:main
ContainerName=frontend
Network=wediga.network
# Reaches the backend by name over the internal network.
Environment=BACKEND_URL=http://backend:8000
# Hardening: the standalone server only writes to /tmp and its on-disk cache,
# both backed by tmpfs, so the root filesystem stays read-only.
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp
Tmpfs=/app/.next/cache

[Service]
Restart=always

[Install]
WantedBy=default.target
