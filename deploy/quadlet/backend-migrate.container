[Unit]
Description=Apply database migrations before the backend starts
# PostgreSQL must accept connections before the migration can run.
Requires=wediga-db.service
After=wediga-db.service

[Container]
# Same image as the backend, run once with the migration command instead of the
# server. Alembic skips already-applied versions, so this runs safely on every
# boot and deploy without touching existing data.
Image=ghcr.io/wediga/wediga-dev-backend:main
ContainerName=backend-migrate
Network=wediga.network
EnvironmentFile=/home/web/wediga-dev/wediga-db.env
Exec=alembic upgrade head
NoNewPrivileges=true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp

[Service]
# Run to completion, then count as active so the backend can order after it.
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=default.target
