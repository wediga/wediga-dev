[Unit]
Description=Caddy reverse proxy for wediga.dev
After=frontend.service
# The public ports come from caddy.socket, which is installed by hand.
Requires=caddy.socket
After=caddy.socket

[Container]
Image=docker.io/library/caddy:2.11.7@sha256:04913b1da43339a40ad1ea87827d70a576ac5aa6cf674c6e24fdca675887533a
ContainerName=caddy
Network=wediga.network
# The network of the NuviraLabs site. Its unit comes with the deploy of the
# NuviraLabs repository, and Caddy only starts once it exists.
Network=nuviralabs.network
Volume=/home/web/wediga-dev/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=caddy-data.volume:/data
NoNewPrivileges=true
# Caddy opens no privileged port itself, they come from caddy.socket. The
# official image sets this capability on /usr/bin/caddy, though, and the kernel
# refuses to start a program whose file capabilities the container lacks.
DropCapability=ALL
AddCapability=CAP_NET_BIND_SERVICE

[Service]
Restart=always

[Install]
WantedBy=default.target
