[Unit]
Description=Caddy reverse proxy for wediga.dev
After=frontend.service
# The public ports come from caddy.socket, which is installed by hand.
Requires=caddy.socket
After=caddy.socket

[Container]
Image=docker.io/library/caddy:2.11.7@sha256:04913b1da43339a40ad1ea87827d70a576ac5aa6cf674c6e24fdca675887533a
ContainerName=caddy
Network=wediga.network
Volume=/home/web/wediga-dev/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=caddy-data.volume:/data
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always

[Install]
WantedBy=default.target
