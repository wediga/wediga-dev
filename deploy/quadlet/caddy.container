[Unit]
Description=Caddy reverse proxy for wediga.dev
After=frontend.service

[Container]
Image=docker.io/library/caddy:2@sha256:af5fdcd76f2db5e4e974ee92f96ee8c0fc3edb55bd4ba5032547cbf3f65e486d
ContainerName=caddy
Network=wediga.network
PublishPort=80:80
PublishPort=443:443
Volume=/home/web/wediga-dev/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=caddy-data.volume:/data
# All capabilities dropped except the one Caddy needs to bind 80/443 inside the
# container. The host side is allowed via the ip_unprivileged_port_start sysctl.
NoNewPrivileges=true
DropCapability=ALL
AddCapability=CAP_NET_BIND_SERVICE

[Service]
Restart=always

[Install]
WantedBy=default.target
