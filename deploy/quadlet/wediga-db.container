[Unit]
Description=PostgreSQL for the wediga.dev backend

[Container]
# Version and digest are pinned. Dependabot does not watch this file, so the
# image is raised by hand. Version 18 is the first that creates UUIDv7 values
# itself, which the schema relies on.
Image=docker.io/library/postgres:18.6-alpine@sha256:10a5c69a83035ab5239f5620d708520e8b28f5aa1f2b20143e6024532edadfb5
ContainerName=wediga-db
Network=wediga.network

# User, database and password come from a file that only exists on the
# server. The backend reads the same file, and it holds nothing else, so this
# container never sees the app's other secrets.
EnvironmentFile=/home/web/wediga-dev/wediga-db.env

# From version 18 on, the image keeps its data in a subdirectory per major
# version below /var/lib/postgresql, so the volume is mounted there.
Volume=wediga-db.volume:/var/lib/postgresql

# Podman runs the check through the container's shell, so the two names
# come from the environment file. They stay unquoted, because Quadlet 5.4 on
# the server drops the last quote and breaks the check, and the names never
# contain spaces.
HealthCmd=pg_isready -d $POSTGRES_DB -U $POSTGRES_USER
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=20s
# The unit only counts as started once the check passes, so backend-migrate
# does not connect before PostgreSQL accepts connections.
Notify=healthy

# The entrypoint starts as root, fixes the ownership of the data directory and
# then drops to the postgres user. Only the capabilities that step needs are
# kept. Under rootless Podman, root in the container is the unprivileged host
# user anyway.
NoNewPrivileges=true
DropCapability=ALL
AddCapability=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID

[Service]
Restart=always

[Install]
WantedBy=default.target
